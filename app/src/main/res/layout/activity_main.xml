<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="28dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/app_name" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/ink" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRuns" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="기록" android:textSize="16sp" android:textColor="@color/ink" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings" style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="설정" android:textSize="16sp" android:textColor="@color/ink" />
        </LinearLayout>

        <!-- 지도(또는 지도를 끈 경우 경로 모양) -->
        <FrameLayout android:id="@+id/mapBox"
            android:layout_width="match_parent" android:layout_height="240dp" android:layout_marginTop="8dp"
            android:background="@drawable/bg_card" />
        <TextView android:id="@+id/mapNote" style="@style/Label"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="18dp">
            <TextView android:id="@+id/motion"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp" android:paddingVertical="6dp"
                android:text="대기 중" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/still" />
            <TextView android:id="@+id/intervalNow"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:gravity="end"
                android:textSize="15sp" android:textStyle="bold" android:textColor="@color/ink" android:fontFeatureSettings="tnum" />
        </LinearLayout>

        <TextView android:id="@+id/time" style="@style/Num"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="0:00" android:textSize="68sp" android:textStyle="bold" />
        <TextView android:id="@+id/timeLabel" style="@style/Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="운동 시간" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="8dp">
            <TextView android:id="@+id/distance" style="@style/Num"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0.00" android:textSize="48sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginBottom="6dp"
                android:text="km" android:textSize="20sp" android:textColor="@color/sub" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="18dp" android:background="@drawable/bg_card"
            android:padding="16dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="평균 페이스" />
                <TextView android:id="@+id/pace" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="--'--&quot;" android:textSize="22sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="뛴 거리" />
                <TextView android:id="@+id/runDist" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="0.00" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/run" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="걸은 거리" />
                <TextView android:id="@+id/walkDist" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="0.00" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/walk" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/status" style="@style/Label"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" />

        <!-- 인터벌 고르기 -->
        <LinearLayout android:id="@+id/coachRow"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_card"
            android:paddingHorizontal="16dp" android:paddingVertical="12dp"
            android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="인터벌 코칭" />
                <TextView android:id="@+id/coachName" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:text="끄기" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="바꾸기" android:textSize="14sp" android:textColor="@color/walk" android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="150dp" android:layout_height="150dp"
            android:layout_gravity="center_horizontal" android:layout_marginTop="24dp"
            android:insetTop="0dp" android:insetBottom="0dp"
            android:text="시작" android:textSize="26sp" android:textStyle="bold"
            app:cornerRadius="75dp" app:backgroundTint="@color/ink" />
        <TextView android:id="@+id/startHint" style="@style/Label"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
            android:text="누르면 바로 기록을 시작합니다" />

        <LinearLayout android:id="@+id/setupCard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:orientation="vertical" android:background="@drawable/bg_card"
            android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="기록이 끊기지 않게 하려면" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:id="@+id/setupText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="@color/sub" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBattery" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="배터리 설정 열기" android:textColor="@color/ink" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
