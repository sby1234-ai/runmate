<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <!-- 날씨 사진(res/drawable-nodpi/bg_*.jpg 이 있으면 씀). 없으면 SkyView가 그라데이션 하늘을 그립니다 -->
    <ImageView android:id="@+id/bgPhoto" android:tag="bgBlur" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" android:visibility="gone" />

    <io.github.sby1234ai.runmate.ui.SkyView android:id="@+id/sky"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- 대기 화면: 날씨, 시작 버튼, 기능 타일 -->
    <ScrollView android:id="@+id/home" android:tag="fg" android:clipToPadding="false"
        android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="18dp" android:paddingBottom="28dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="@string/app_name" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFFFF"
                android:shadowColor="#40000000" android:shadowRadius="6" />
                <ImageButton android:id="@+id/btnSettings"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_button" android:src="@drawable/ic_settings"
                    android:contentDescription="설정" />
            </LinearLayout>

            <!-- 날씨: 판 없이 배경 위에 글자만(그림자로 읽히게) -->
            <TextView android:id="@+id/greeting" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="22dp" android:textSize="16sp" android:textColor="#E6FFFFFF"
                android:shadowColor="#73000000" android:shadowRadius="10" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="2dp">
                <TextView android:id="@+id/temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="--°" android:textSize="64sp" android:textColor="#FFFFFFFF"
                    android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:fontFeatureSettings="tnum"
                    android:shadowColor="#73000000" android:shadowRadius="14" />
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:id="@+id/weatherLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFFFF"
                        android:shadowColor="#73000000" android:shadowRadius="10" />
                    <TextView android:id="@+id/weatherMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="14sp" android:textColor="#E6FFFFFF"
                        android:shadowColor="#73000000" android:shadowRadius="10" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/weatherTip" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:background="@drawable/bg_chip_dark"
                android:paddingHorizontal="12dp" android:paddingVertical="7dp"
                android:textSize="14sp" android:textColor="#FFFFFFFF" />

            <GridLayout android:id="@+id/tiles" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="26dp" android:layout_marginHorizontal="-5dp" android:columnCount="2" android:useDefaultMargins="false" />

            <LinearLayout android:id="@+id/setupCard"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="vertical" android:background="@drawable/bg_tile"
                android:padding="16dp" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="기록이 끊기지 않게 하려면" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
                <TextView android:id="@+id/setupText" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#D9FFFFFF" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBattery" style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:text="배터리 설정 열기  ›" android:textColor="#FFFFFFFF" app:strokeColor="#4DFFFFFF" app:cornerRadius="10dp" />
            </LinearLayout>

            <!-- 시작 버튼은 맨 아래(엄지가 닿는 곳) -->
            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp" />

            <!-- 빠른 켜고 끄기: 음성 안내 · 자동 일시정지(켜짐 = 청록 칸, 꺼짐 = 무색·작게·사선) -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">
                <LinearLayout android:id="@+id/togVoice" android:layout_width="0dp" android:layout_weight="1" android:layout_height="84dp"
                    android:layout_marginEnd="6dp" android:orientation="vertical" android:gravity="center"
                    android:clickable="true" android:focusable="true">
                    <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:src="@drawable/ic_volume" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/togVoiceSlash" android:layout_width="match_parent" android:layout_height="match_parent"
                            android:src="@drawable/ic_slash" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:id="@+id/togVoiceText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="음성 안내" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:id="@+id/togPause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="84dp"
                    android:layout_marginStart="6dp" android:orientation="vertical" android:gravity="center"
                    android:clickable="true" android:focusable="true">
                    <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                        <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
                            android:src="@drawable/ic_pause" android:importantForAccessibility="no" />
                        <ImageView android:id="@+id/togPauseSlash" android:layout_width="match_parent" android:layout_height="match_parent"
                            android:src="@drawable/ic_slash" android:importantForAccessibility="no" />
                    </FrameLayout>
                    <TextView android:id="@+id/togPauseText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" android:text="자동 일시정지" android:textSize="14sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnStart"
                android:layout_width="match_parent" android:layout_height="68dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_pill_glass"
                android:clickable="true" android:focusable="true" android:contentDescription="달리기 시작">
                <FrameLayout android:id="@+id/startIcon" android:layout_width="34dp" android:layout_height="34dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center"
                        android:src="@drawable/ic_play" app:tint="#FF06221F" android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView android:id="@+id/startLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                    android:text="달리기 시작" android:textSize="21sp" android:fontFeatureSettings="tnum" android:textStyle="bold" android:textColor="#FFFFFFFF" />
            </LinearLayout>
            <TextView android:id="@+id/weekLine" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" android:layout_marginTop="10dp"
                android:textSize="14sp" android:textColor="#E6FFFFFF" android:fontFeatureSettings="tnum"
                android:shadowColor="#73000000" android:shadowRadius="8" />

            <TextView android:id="@+id/credit" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:gravity="center"
                android:textSize="11sp" android:textColor="#B3FFFFFF" />
        </LinearLayout>
    </ScrollView>

    <!-- 달리는 중 화면 -->
    <ScrollView android:id="@+id/runPanel" android:tag="fg" android:visibility="gone" android:clipToPadding="false"
        android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="24dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/motion"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="16dp" android:paddingVertical="7dp"
                    android:text="대기 중" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/still" />
                <TextView android:id="@+id/intervalNow"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:gravity="end"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:fontFeatureSettings="tnum" />
            </LinearLayout>

            <io.github.sby1234ai.runmate.ui.RunnerView android:id="@+id/runner"
                android:layout_width="104dp" android:layout_height="104dp" android:layout_marginTop="18dp" />

            <TextView android:id="@+id/time" style="@style/Num"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="0:00" android:textSize="76sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
            <TextView android:id="@+id/timeLabel"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="운동 시간" android:textSize="13sp" android:textColor="#CCFFFFFF" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="14dp">
                <TextView android:id="@+id/distance" style="@style/Num"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0.00" android:textSize="48sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:layout_marginBottom="6dp"
                    android:text="km" android:textSize="20sp" android:textColor="#CCFFFFFF" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:id="@+id/statsA" android:orientation="horizontal" android:layout_marginTop="22dp" android:background="@drawable/bg_glass" android:divider="@drawable/divider_v" android:showDividers="middle"
                android:paddingVertical="14dp" android:paddingHorizontal="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/pace" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--'--&quot;" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="평균 페이스" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/runDist" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0.00" android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFB199" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="뛴 거리 km" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/walkDist" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0.00" android:textSize="22sp" android:textStyle="bold" android:textColor="#FF8EE6DA" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="걸은 거리 km" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:id="@+id/statsB" android:orientation="horizontal" android:layout_marginTop="8dp" android:background="@drawable/bg_glass"
                android:divider="@drawable/divider_v" android:showDividers="middle"
                android:paddingVertical="12dp" android:paddingHorizontal="8dp">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/lapPace" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--'--&quot;" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                    <TextView android:id="@+id/lapLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="1km째 페이스" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/steps" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="걸음" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:id="@+id/cadence" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="--" android:textSize="20sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:text="분당 걸음" android:textSize="12sp" android:textColor="#CCFFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/status"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:gravity="center" android:textSize="12sp" android:textColor="#B3FFFFFF" />

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="20dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp"
                android:orientation="horizontal" android:layout_marginTop="20dp">
                <LinearLayout android:id="@+id/btnPause"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                    android:layout_marginEnd="6dp" android:orientation="horizontal" android:gravity="center"
                    android:background="@drawable/bg_pill_pause" android:clickable="true" android:focusable="true">
                    <ImageView android:id="@+id/pauseIcon" android:layout_width="20dp" android:layout_height="20dp"
                        android:src="@drawable/ic_pause_bars" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/pauseText" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:text="일시정지" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
                </LinearLayout>
                <LinearLayout android:id="@+id/btnStop"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                    android:layout_marginStart="6dp" android:orientation="horizontal" android:gravity="center"
                    android:background="@drawable/bg_pill_stop" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_stop"
                        android:importantForAccessibility="no" app:tint="@color/run" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="10dp" android:text="운동 종료" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFFF8A6B" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="실수로 끝나지 않게, 운동 종료는 길게 누르세요" android:textSize="13sp" android:textColor="#B3FFFFFF" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
