<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">

    <!-- 첫 화면과 같은 사진을 흐리고 어둡게 깔아, 카드 유리판 뒤로 비치게 -->
    <ImageView android:id="@+id/prepBg" android:tag="bgBlur" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="#8C060A0E" />

    <ScrollView android:id="@+id/prepScroll" android:tag="fg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="24dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="달리기 준비" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/ink" />

            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="운동 고르기" />
            <LinearLayout android:id="@+id/plans" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:text="▬ 뛰기    ▭ 걷기  (띠 길이 = 시간)" android:textSize="11sp" android:textColor="#B3FFFFFF" />

            <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:text="달리는 동안" />
            <LinearLayout android:id="@+id/rowVoice" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="64dp" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="음성 안내" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
                    <TextView android:id="@+id/voiceState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="13sp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swVoice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:id="@+id/rowPause" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:minHeight="64dp" android:paddingHorizontal="16dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="자동 일시정지" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
                    <TextView android:id="@+id/pauseState" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" android:textSize="13sp" />
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swPause"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp" />

            <LinearLayout android:id="@+id/btnGo"
                android:layout_width="match_parent" android:layout_height="68dp"
                android:orientation="horizontal" android:gravity="center"
                android:clickable="true" android:focusable="true" android:contentDescription="시작">
                <FrameLayout android:id="@+id/goIcon" android:layout_width="34dp" android:layout_height="34dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center"
                        android:src="@drawable/ic_play" android:tint="#FF06221F" android:importantForAccessibility="no" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp"
                    android:text="시작" android:textSize="21sp" android:textStyle="bold" android:textColor="#FFFFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 3·2·1 카운트다운 -->
    <TextView android:id="@+id/countdown" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:background="#E60E141A" android:visibility="gone" android:clickable="true"
        android:textSize="120sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:fontFeatureSettings="tnum" />
</FrameLayout>
