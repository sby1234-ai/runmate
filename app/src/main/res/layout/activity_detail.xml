<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="28dp">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="@color/sub" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="2dp">
            <TextView android:id="@+id/bigDist" style="@style/Num"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="52sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:layout_marginBottom="7dp"
                android:text="km" android:textSize="20sp" android:textColor="@color/sub" />
        </LinearLayout>
        <TextView android:id="@+id/badges" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/run"
            android:visibility="gone" />

        <FrameLayout android:id="@+id/mapBox"
            android:layout_width="match_parent" android:layout_height="360dp" android:layout_marginTop="14dp"
            android:background="@drawable/bg_card" android:tag="glass" />
        <TextView android:id="@+id/legend" style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <GridLayout android:id="@+id/grid" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:columnCount="2" android:background="@drawable/bg_card" android:tag="glass" android:padding="16dp" />

        <!-- 워치 심박(헬스 커넥트) -->
        <LinearLayout android:id="@+id/heartCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_card" android:tag="glass"
            android:padding="16dp" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="심박 (워치)" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:id="@+id/heartText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="14sp" android:textColor="#D9FFFFFF" android:lineSpacingExtra="3dp" />
            <io.github.sby1234ai.runmate.ui.HeartChart android:id="@+id/heartChart" android:layout_width="match_parent"
                android:layout_height="120dp" android:layout_marginTop="10dp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/heartBtn" style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone"
                android:text="워치 심박 가져오기" android:textColor="#FFFFFFFF" app:strokeColor="#4DFFFFFF" app:cornerRadius="10dp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="1km 구간" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
        <LinearLayout android:id="@+id/splits" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:tag="glass" android:padding="14dp" />

        <com.google.android.material.button.MaterialButton android:id="@+id/btnShare"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp"
            android:text="이미지로 공유" app:backgroundTint="@color/run" app:cornerRadius="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnGpx"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                android:text="GPX로 내보내기" android:textColor="@color/ink" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="56dp" android:layout_marginStart="8dp"
                android:text="삭제" android:textColor="@color/run" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
