<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="내 기록" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/ink" />

        <LinearLayout android:id="@+id/summaryRow" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="14dp" android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card" android:tag="glass" android:padding="14dp" android:layout_marginEnd="6dp">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이번 주" />
                <TextView android:id="@+id/weekKm" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="26sp" android:textStyle="bold" />
                <TextView android:id="@+id/weekN" style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card" android:tag="glass" android:padding="14dp" android:layout_marginStart="6dp">
                <TextView style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이번 달" />
                <TextView android:id="@+id/monthKm" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:textSize="26sp" android:textStyle="bold" />
                <TextView android:id="@+id/monthN" style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/prCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:tag="glass" android:padding="14dp"
            android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="최고 기록" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
            <LinearLayout android:id="@+id/prList" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView android:id="@+id/summary" style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />
        <LinearLayout android:id="@+id/list" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="40dp" android:gravity="center" android:visibility="gone"
            android:text="아직 기록이 없습니다.\n첫 화면에서 시작을 눌러 첫 기록을 남겨 보세요."
            android:textSize="15sp" android:textColor="@color/sub" android:lineSpacingExtra="4dp" />
    </LinearLayout>
</ScrollView>
