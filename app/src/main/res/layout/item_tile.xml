<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_tile"
    android:padding="16dp" android:minHeight="128dp"
    android:clickable="true" android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">
    <FrameLayout android:id="@+id/iconBg" android:layout_width="42dp" android:layout_height="42dp"
        android:background="@drawable/bg_circle">
        <ImageView android:id="@+id/icon" android:layout_width="22dp" android:layout_height="22dp"
            android:layout_gravity="center" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/ink" />
    <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/sub"
        android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum" />
</LinearLayout>
