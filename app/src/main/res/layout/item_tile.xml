<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/bg_tile"
    android:paddingHorizontal="14dp" android:paddingVertical="16dp"
    android:clickable="true" android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">
    <FrameLayout android:id="@+id/iconBg" android:layout_width="36dp" android:layout_height="36dp"
        android:background="@drawable/bg_icon_sq">
        <ImageView android:id="@+id/icon" android:layout_width="19dp" android:layout_height="19dp"
            android:layout_gravity="center" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="11dp">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:textStyle="bold" android:textColor="@color/ink"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/sub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="@color/sub"
            android:maxLines="1" android:ellipsize="end" android:fontFeatureSettings="tnum" />
    </LinearLayout>
</LinearLayout>
