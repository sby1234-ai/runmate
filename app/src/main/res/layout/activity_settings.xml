<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="설정" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/ink" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:padding="16dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swMap"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="지도 보기" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"
                android:text="달리기를 마친 뒤 기록 화면에서 지나간 길을 지도 위에 보여 줍니다. 지도 그림은 OpenStreetMap 서버에서 받아 오므로, 그 서버는 기록 화면에 띄운 지역의 지도 조각 요청을 받습니다. 기록 자체는 어디로도 보내지 않습니다. 끄면 지도 없이 길 모양만 그립니다." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="16dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swWeather"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="날씨 배경" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"
                android:text="첫 화면 배경을 지금 날씨(맑음·구름·비·눈·밤)에 맞춰 바꾸고, 기온과 달리기 조언을 보여 줍니다. 이를 위해 대략적인 위치(소수점 첫째 자리, 약 10km 단위)만 Open-Meteo 날씨 서버에 보냅니다. 30분에 한 번까지만 받아 옵니다. 끄면 시간대에 맞춘 기본 배경을 씁니다." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="16dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swVoice"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="음성 안내" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"
                android:text="1km마다 거리와 방금 1km에 걸린 시간을 읽어 줍니다. 걷기↔뛰기가 바뀐 것이 확실하면 알려 주고, 인터벌을 골랐으면 뛰기·걷기 차례를 불러 줍니다. 음악을 듣는 중이면 잠깐 소리를 줄였다가 되돌립니다." />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTestVoice"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="미리 들어 보기" android:textColor="@color/ink" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="16dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swPause"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="자동 일시정지" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"
                android:text="신호등 앞처럼 5초 넘게 멈춰 있으면 운동 시간을 멈추고, 다시 움직이면 이어서 잽니다. 평균 페이스는 이 설정과 상관없이 멈춘 시간을 빼고 계산합니다." />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="16dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swLock"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="잠금 화면에 달리기 화면" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"
                android:text="기본은 꺼짐: 잠금 화면에는 시간·거리·일시정지가 있는 알림 카드만 보입니다. 켜면 달리는 중 화면을 다시 켤 때 잠금 위에 달리기 화면이 바로 나옵니다(다른 화면으로 가려면 잠금을 풀어야 함). 알림 카드가 안 보이면 갤럭시 설정 → 잠금 화면 → 알림을 「자세히」로 바꿔 주세요." />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnFullScreen"
                style="@style/Widget.Material3.Button.OutlinedButton" android:visibility="gone"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="잠금 화면 표시 권한 켜기" android:textColor="@color/ink" />
        </LinearLayout>

        <!-- 실시간 알림(상태 표시줄 칩)을 켤 수 있는 휴대폰(안드로이드 16 분기 업데이트 이상)에서 꺼져 있을 때만 보임 -->
        <LinearLayout android:id="@+id/liveCard" android:visibility="gone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="실시간 알림 (초록 칩)" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:id="@+id/liveState" style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:lineSpacingExtra="3dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnLive"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="실시간 알림 설정 열기" android:textColor="@color/ink" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="저장 공간" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView android:id="@+id/storage" style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnClearMap"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="받아 둔 지도 지우기" android:textColor="@color/ink" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="16dp">
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swUpdate"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="새 버전 자동 확인" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/ink" />
            <TextView style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:lineSpacingExtra="3dp"
                android:text="하루 한 번 GitHub에 새 버전이 있는지 확인하고, 있으면 알려 줍니다. 「업데이트」를 누르면 받아서 진짜 파일인지(SHA-256) 확인한 뒤 설치 화면을 엽니다. 처음 한 번은 「출처를 알 수 없는 앱 설치」 허용이 필요합니다. 기록은 그대로 남습니다." />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCheckUpdate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="지금 확인" android:textColor="@color/ink" />
        </LinearLayout>

        <TextView android:id="@+id/about" style="@style/Label" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>
