<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp"
    android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">
    <TextView android:id="@+id/date" style="@style/Label" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="bottom" android:layout_marginTop="4dp">
        <TextView android:id="@+id/dist" style="@style/Num" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="km"
            android:layout_marginStart="4dp" android:layout_marginBottom="3dp" android:textColor="@color/sub" />
        <TextView android:id="@+id/meta" style="@style/Num" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:gravity="end" android:layout_marginBottom="3dp"
            android:textSize="15sp" android:textColor="@color/sub" />
    </LinearLayout>
    <LinearLayout android:id="@+id/ratio" android:layout_width="match_parent" android:layout_height="6dp"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <View android:id="@+id/ratioRun" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/run" />
        <View android:id="@+id/ratioWalk" android:layout_width="0dp" android:layout_height="match_parent" android:background="@color/walk" />
    </LinearLayout>
</LinearLayout>
