<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RunMate" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/walk</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Num">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Label">
        <item name="android:textColor">@color/sub</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
